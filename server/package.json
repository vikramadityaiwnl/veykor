    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0"
  }
}
