{
  "name": "@veykor/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "start": "node dist/index.js",
    "test": "npm run typecheck && node --import tsx --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@muse-code/sdk": "^1.4.14",
    "@veykor/shared": "file:../shared",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0"
  }
}
