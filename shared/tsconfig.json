  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true
  },
  "include": [
    "auth/**/*.ts",
    "chats/**/*.ts",
    "health/**/*.ts",
    "integrations/**/*.ts",
    "preferences/**/*.ts",
